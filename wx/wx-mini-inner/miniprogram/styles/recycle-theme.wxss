/* 回收线：中性色走全局 Token，强调色映射为 --rec-* 供存量页继续使用 */
page {
  --rec-bg: var(--color-bg-page);
  --rec-card: var(--color-bg-card);
  --rec-ink: var(--color-text-primary);
  --rec-muted: var(--color-text-secondary);
  --rec-line: var(--color-border);
  --rec-accent: var(--color-recycle);
  --rec-accent-soft: var(--color-recycle-soft);
  --rec-price: var(--color-price);
  --rec-danger: var(--color-danger);
  --rec-scarce: var(--color-scarce);
  background: var(--rec-bg);
  color: var(--rec-ink);
}
