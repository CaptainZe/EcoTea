/* 销售线：中性色走全局 Token，强调色映射为 --sale-* 供存量页继续使用 */
page {
  --sale-bg: var(--color-bg-page);
  --sale-card: var(--color-bg-card);
  --sale-ink: var(--color-text-primary);
  --sale-muted: var(--color-text-secondary);
  --sale-line: var(--color-border);
  --sale-accent: var(--color-sale);
  --sale-accent-soft: var(--color-sale-soft);
  --sale-price: var(--color-price);
  --sale-danger: var(--color-danger);
  --sale-scarce: var(--color-scarce);
  background: var(--sale-bg);
  color: var(--sale-ink);
}

.sale-btn {
  margin: 0 !important;
  box-sizing: border-box;
}

.sale-btn-ghost {
  background: var(--sale-card) !important;
  color: var(--sale-accent) !important;
  border: 2rpx solid var(--sale-accent) !important;
}

.sale-btn-primary {
  background: var(--sale-accent) !important;
  color: #fff !important;
  border: none !important;
}

.sale-btn-muted {
  background: var(--sale-accent-soft) !important;
  color: var(--sale-accent) !important;
  border: 2rpx solid var(--sale-accent) !important;
}
