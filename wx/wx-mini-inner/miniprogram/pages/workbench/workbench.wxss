.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.group {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx 12rpx;
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 12rpx 20rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.entry {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 28rpx;
  box-sizing: border-box;
}

.entry-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.entry-title {
  font-size: 24rpx;
  color: #374151;
  text-align: center;
  line-height: 1.3;
}

.empty {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
}

.empty-tip {
  font-size: 24rpx;
  color: #9ca3af;
}
