.page {
  padding: 32rpx 40rpx 48rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  color: #666;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.input {
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.btn {
  margin-top: 40rpx;
  background: var(--color-brand);
  color: #fff;
}

.tip {
  margin-top: 32rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.6;
}
