.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 40rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: #888;
}

.value {
  color: #333;
  max-width: 60%;
  text-align: right;
}

.value.on {
  color: var(--color-brand);
  font-weight: 600;
}

.btn {
  margin-top: 24rpx;
  background: var(--color-brand);
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: var(--color-brand);
  border: 2rpx solid var(--color-brand);
}

.btn-danger {
  background: var(--color-danger);
}
