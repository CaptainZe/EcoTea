<view class="page">
  <view class="field">
    <text class="label">原密码</text>
    <input
      class="input"
      password
      placeholder="请输入原密码"
      value="{{oldPassword}}"
      bindinput="onOld"
    />
  </view>
  <view class="field">
    <text class="label">新密码</text>
    <input
      class="input"
      password
      placeholder="6～32 位"
      value="{{newPassword}}"
      bindinput="onNew"
    />
  </view>
  <view class="field">
    <text class="label">确认新密码</text>
    <input
      class="input"
      password
      placeholder="再输入一次新密码"
      value="{{confirmPassword}}"
      bindinput="onConfirm"
    />
  </view>
  <button class="btn" type="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">
    确认修改
  </button>
  <view class="tip">修改成功后需使用新密码重新登录</view>
</view>
