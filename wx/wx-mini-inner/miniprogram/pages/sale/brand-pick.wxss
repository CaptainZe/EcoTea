@import '../../styles/sale-theme.wxss';

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--sale-bg);
  overflow: hidden;
}

.flex-fill {
  flex: 1;
  height: 0;
  min-height: 0;
}

.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--sale-card);
  border-bottom: 1rpx solid var(--sale-line);
  box-sizing: border-box;
}

.search-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
}

.search-input {
  display: block;
  width: 100%;
  height: 68rpx;
  padding: 0 56rpx 0 24rpx;
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  border-radius: 34rpx;
  font-size: 26rpx;
  color: var(--sale-ink);
  box-sizing: border-box;
}

.search-clear {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--sale-muted);
}

.done-btn {
  flex-shrink: 0;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 34rpx;
  background: var(--sale-accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
}

.tip {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: var(--sale-accent);
  background: var(--sale-accent-soft);
}

.main {
  position: relative;
}

.list-scroll {
  height: 100%;
  box-sizing: border-box;
  padding-right: 56rpx;
}

.sec-anchor {
  background: var(--sale-card);
}

.block-hd {
  padding: 20rpx 28rpx 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--sale-ink);
  background: var(--sale-bg);
  letter-spacing: 1rpx;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 24rpx 24rpx;
  background: var(--sale-card);
}

.chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  padding: 12rpx 18rpx 12rpx 12rpx;
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.chip.is-on {
  background: var(--sale-accent-soft);
  border-color: var(--sale-accent);
}

.chip-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: #eef1ee;
  flex-shrink: 0;
}

.chip-name {
  font-size: 26rpx;
  color: var(--sale-ink);
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip.is-on .chip-name {
  color: var(--sale-accent);
  font-weight: 650;
}

.chip-check {
  font-size: 22rpx;
  color: var(--sale-accent);
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--sale-line);
  background: var(--sale-card);
  box-sizing: border-box;
}

.row.is-on {
  background: #f5faf4;
}

.logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #eef1ee;
  flex-shrink: 0;
}

.logo-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--sale-accent);
  background: var(--sale-accent-soft);
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--sale-ink);
}

.row.is-on .name {
  color: var(--sale-accent);
  font-weight: 650;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--sale-line);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  flex-shrink: 0;
}

.check.is-on {
  border-color: var(--sale-accent);
  background: var(--sale-accent);
  color: #fff;
  font-weight: 700;
}

.list-pad {
  height: 24rpx;
}

.index-rail {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx;
  background: rgba(243, 245, 241, 0.92);
  border-radius: 20rpx 0 0 20rpx;
}

.index-item {
  width: 44rpx;
  min-height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--sale-ink);
  font-weight: 600;
}

.index-item.is-on {
  color: var(--sale-accent);
  font-weight: 800;
}

.index-bubble {
  position: absolute;
  left: 50%;
  top: 42%;
  transform: translate(-50%, -50%);
  z-index: 20;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: rgba(28, 36, 28, 0.72);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sale-muted);
  font-size: 28rpx;
}

.empty-mini {
  padding: 80rpx 0;
  text-align: center;
  color: var(--sale-muted);
  font-size: 26rpx;
}

.footer {
  padding: 12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--sale-line);
  background: var(--sale-card);
}

.btn-reset {
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--sale-card);
  color: var(--sale-ink);
  border: 2rpx solid var(--sale-line);
}
