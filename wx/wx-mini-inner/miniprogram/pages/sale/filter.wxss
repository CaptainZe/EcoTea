@import '../../styles/sale-theme.wxss';

/* iOS：避免 scroll-view + flex height:0 导致中间空白 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--sale-bg);
  overflow: hidden;
}

.body {
  flex: 1;
  width: 100%;
  height: calc(100vh - 112rpx - env(safe-area-inset-bottom));
  padding: 24rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 650;
  margin-bottom: 16rpx;
  color: var(--sale-ink);
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  background: var(--sale-card);
  border: 1rpx solid var(--sale-line);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.link-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--sale-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-text.is-on {
  color: var(--sale-accent);
  font-weight: 650;
}

.link-arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: var(--sale-muted);
  line-height: 1;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -7rpx;
}

.ftag {
  font-size: 26rpx;
  color: var(--sale-ink);
  background: var(--sale-card);
  border: 1rpx solid var(--sale-line);
  padding: 12rpx 22rpx;
  border-radius: 10rpx;
  margin: 0 7rpx 14rpx;
}

.ftag.is-on {
  color: var(--sale-accent);
  background: var(--sale-accent-soft);
  border-color: var(--sale-accent);
  font-weight: 650;
}

.empty-mini {
  color: var(--sale-muted);
  font-size: 24rpx;
  margin: 0 7rpx 14rpx;
}

.price-row {
  display: flex;
  align-items: center;
}

.price-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: var(--sale-card);
  border: 1rpx solid var(--sale-line);
  border-radius: 12rpx;
  font-size: 26rpx;
}

.price-sep {
  color: var(--sale-muted);
  margin: 0 12rpx;
  flex-shrink: 0;
}

.hint {
  margin-top: 12rpx;
  color: var(--sale-price);
  font-size: 22rpx;
}

.footer {
  flex-shrink: 0;
  display: flex;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--sale-line);
  background: var(--sale-card);
  box-sizing: border-box;
}

.btn-reset,
.btn-ok {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-reset {
  margin-right: 20rpx;
  background: var(--sale-card);
  color: var(--sale-ink);
  border: 2rpx solid var(--sale-line);
}

.btn-ok {
  background: var(--sale-accent);
  color: #fff;
  border: 2rpx solid var(--sale-accent);
  font-weight: 650;
}
