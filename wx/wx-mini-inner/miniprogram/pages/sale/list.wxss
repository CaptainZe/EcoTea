@import '../../styles/sale-theme.wxss';

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--sale-bg);
}

.sticky-head {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--sale-card);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 12rpx;
  background: var(--sale-card);
}

.search-field {
  position: relative;
  flex: 1;
  min-width: 0;
}

.search-input {
  display: block;
  width: 100%;
  height: 72rpx;
  padding: 0 140rpx 0 24rpx;
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--sale-ink);
  box-sizing: border-box;
}

.search-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: var(--sale-accent);
  color: #fff;
  font-size: 24rpx;
  font-weight: 650;
}

.search-btn.is-disabled {
  opacity: 0.45;
}

.scan-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 72rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.scan-icon {
  width: 48rpx;
  height: 48rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 24rpx 16rpx;
  background: var(--sale-card);
  border-bottom: 1rpx solid var(--sale-line);
}

.tool-chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--sale-ink);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.tool-chip.is-on {
  background: var(--sale-accent-soft);
  border-color: var(--sale-accent);
  color: var(--sale-accent);
  font-weight: 650;
}

.filter-entry {
  margin-left: auto;
  height: 56rpx;
  padding: 0 4rpx;
  font-size: 24rpx;
  color: var(--sale-muted);
  background: transparent;
  border: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.filter-entry.is-on {
  color: #b45309;
  font-weight: 650;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
}

.mode-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: var(--sale-accent-soft);
  color: var(--sale-accent);
  font-size: 24rpx;
}

.mode-clear {
  color: var(--sale-accent);
  font-weight: 650;
  padding: 8rpx 0 8rpx 16rpx;
}

.meta {
  padding: 8rpx 28rpx 0;
  color: var(--sale-muted);
  font-size: 22rpx;
}

.list {
  padding: 16rpx 24rpx;
}

.card {
  display: flex;
  background: var(--sale-card);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(216, 221, 214, 0.7);
}

.card-media {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
}

.cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: 12rpx;
  background: var(--sale-bg);
}

.card-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.body {
  flex: 1;
}

.title {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--sale-ink);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  font-size: 20rpx;
  color: var(--sale-muted);
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.row-price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sale {
  color: var(--sale-price);
  font-size: 32rpx;
  font-weight: 700;
}

.official {
  color: var(--sale-muted);
  font-size: 22rpx;
}

.discount {
  color: var(--sale-price);
  font-size: 22rpx;
  font-weight: 650;
  background: #fff7ed;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}

.card-foot {
  margin-top: 10rpx;
}

.stock-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
}

.stock {
  color: var(--sale-accent);
  font-weight: 600;
}

.stock.scarce {
  color: var(--sale-scarce);
}

.dmg {
  color: var(--sale-price);
  font-size: 20rpx;
}

.wh-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.wh-chip {
  font-size: 20rpx;
  color: var(--sale-accent);
  background: var(--sale-accent-soft);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.card-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.same-btn,
.quote-btn {
  font-size: 24rpx;
  color: var(--sale-accent);
  border: 2rpx solid var(--sale-accent);
  border-radius: 28rpx;
  padding: 8rpx 22rpx;
  line-height: 1.2;
  background: var(--sale-card);
}

.quote-btn {
  background: var(--sale-accent);
  color: #fff;
  border-color: var(--sale-accent);
}

.quote-btn.is-in {
  background: var(--sale-accent-soft);
  color: var(--sale-accent);
  border-color: var(--sale-accent);
  font-weight: 650;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--sale-muted);
  font-size: 28rpx;
}

.empty-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--sale-muted);
}

.footer {
  text-align: center;
  color: var(--sale-muted);
  font-size: 24rpx;
  padding: 16rpx;
}

.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.fab-icon {
  width: 96rpx;
  height: 96rpx;
}

.fab-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--sale-scarce);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
  font-weight: 700;
}
