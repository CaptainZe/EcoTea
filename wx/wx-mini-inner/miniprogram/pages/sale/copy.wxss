@import '../../styles/sale-theme.wxss';

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--sale-bg);
}

.preview-card {
  background: var(--sale-card);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(216, 221, 214, 0.7);
  margin-bottom: 20rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--sale-muted);
  margin-bottom: 12rpx;
}

.preview-text {
  font-size: 28rpx;
  color: var(--sale-ink);
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.form {
  background: var(--sale-card);
  border-radius: 16rpx;
  padding: 8rpx 28rpx 28rpx;
  border: 1rpx solid rgba(216, 221, 214, 0.7);
}

.field {
  padding-top: 24rpx;
}

.label-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--sale-muted);
  margin-bottom: 12rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.stock-ref {
  font-size: 22rpx;
  color: var(--sale-price);
  line-height: 1.35;
}

.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--sale-ink);
  box-sizing: border-box;
}

.hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sale-price);
}

.area {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  background: var(--sale-bg);
  border: 1rpx solid var(--sale-line);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--sale-ink);
  box-sizing: border-box;
}

.bar-space {
  height: 24rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--sale-card);
  box-shadow: 0 -4rpx 24rpx rgba(28, 36, 28, 0.06);
  box-sizing: border-box;
  z-index: 20;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--sale-accent);
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: 0.88;
}

.empty {
  padding: 160rpx 40rpx;
  text-align: center;
  color: var(--sale-muted);
  font-size: 28rpx;
}
