.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.label {
  color: #999;
  font-size: 24rpx;
  flex-shrink: 0;
}

.name {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.quick {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f766e;
  padding: 0 12rpx 20rpx;
}

.entry {
  width: 25%;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 28rpx;
  box-sizing: border-box;
  vertical-align: top;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
  padding: 20rpx;
  background: rgba(15, 118, 110, 0.08);
  border-radius: 24rpx;
  box-sizing: content-box;
}

.entry.recycle .entry-icon {
  background: rgba(180, 83, 9, 0.1);
}

.entry-title {
  font-size: 24rpx;
  color: #374151;
}

.tip {
  margin-top: 40rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 1.6;
}
