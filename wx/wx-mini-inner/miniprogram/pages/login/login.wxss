.page {
  padding: 48rpx 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 48rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  color: #666;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.input {
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.btn {
  margin-top: 40rpx;
  background: #0f766e;
  color: #fff;
}

.divider {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5e5;
}

.divider-text {
  color: #999;
  font-size: 24rpx;
}

.btn-wx {
  margin-top: 28rpx;
  background: #07c160 !important;
  color: #fff !important;
}

.hint {
  margin-top: 28rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.6;
}
