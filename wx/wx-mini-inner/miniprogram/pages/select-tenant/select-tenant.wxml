<view class="page">
  <view class="title">选择工作店铺</view>
  <view class="hint" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{!tenants.length}}">暂无可用店铺，请先登录或联系平台挂店</view>

  <view
    class="item {{selectedId == item.tenantId ? 'item-on' : ''}}"
    wx:for="{{tenants}}"
    wx:key="tenantId"
    data-id="{{item.tenantId}}"
    data-name="{{item.name}}"
    bindtap="onPick"
  >
    <view class="name">{{item.name}}</view>
    <view class="id">租户ID：{{item.tenantId}}</view>
  </view>

  <button
    class="btn"
    type="primary"
    loading="{{submitting}}"
    disabled="{{submitting || !selectedId}}"
    bindtap="onConfirm"
  >
    进入店铺
  </button>
</view>
