.page {
  padding: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint,
.empty {
  color: #999;
  margin: 24rpx 0;
}

.item {
  background: #fff;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.item-on {
  border-color: var(--color-brand);
  background: var(--color-brand-soft);
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.id {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
}

.btn {
  margin-top: 40rpx;
  background: var(--color-brand);
  color: #fff;
}
