# 复制为 application-dev.yml 或 application-prod.yml 后填写真实值（本文件可提交 git）
# 公共配置见同目录 application.yml（可提交）；本文件仅环境相关
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/tea?useSSL=false&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: your_db_user
    password: your_db_password
  redis:
    host: 127.0.0.1
    port: 6379
    # password: your_redis_password

logging:
  level:
    com.ecotea.api: DEBUG   # prod 建议改为 INFO

# 微信公众号（订阅号）；未接入前可先占位
wx:
  mp:
    app-id: your-app-id
    secret: your-app-secret
    token: your-server-token
    aes-key: # 明文模式可留空；安全模式必填
    config-storage:
      type: RedisTemplate
      key-prefix: wx:mp: